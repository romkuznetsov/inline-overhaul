# move-inline — шаги записи (что показывается — move-inline.md)
# Каркас 2026-10-05: Move selected text выключен до ролика и включается на камеру; дальше — по контролу на этап.
# Разделители стартового набора — `||`. Movement step не показан: Character на целом слове выглядит порчей текста.
title Move selected text left and right | Slide a word or a letter along the line with one key
preset navigation.moveSelection.inlineEnabled = false
open Inline move.md
select 1. buy milk bread and eggs @ milk
stage Move selected text
say Move selected text → on
settings Navigation
set Move selected text = on
select 1. buy milk bread and eggs @ milk
say A selected word moves word by word
cmd move-right
expect 1. buy bread milk and eggs
cmd move-right
expect 1. buy bread and milk eggs
select 2. fix teh typo @ e
say A part of a word moves by letter
cmd move-right
expect 2. fix the typo
select 3. one moret ime @ t
say …and stays inside its word
cmd move-right
cmd move-right
expect 3. one moret ime
select 4. #todo || call the plumber || 📅2026-10-06 @ call
say A word can jump past the Separator
cmd move-left
expect 4. #todo call || the plumber || 📅2026-10-06

stage Step out of the word
say Step out of the word → on
settings Navigation
set Step out of the word = on
caret 3. one moret ime
select 3. one moret ime @ t
say Move right → the letter leaves its word
cmd move-right
expect 3. one more time

stage Stay between Separators
say Continue past Separators → off
settings Navigation
set Continue past Separators = off
caret 4. #todo || call the plumber || 📅2026-10-06
select 4. #todo || call the plumber || 📅2026-10-06 @ call
say Move left → it stays between the Separators
cmd move-left
cmd move-left
expect 4. #todo || call the plumber || 📅2026-10-06
