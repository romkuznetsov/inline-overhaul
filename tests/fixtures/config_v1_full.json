      "io": {
        "separator1": "//",
        "separator2": "::"
      },
      "order": {
        "left": [
          "status"
        ],
        "right": [
          "project"
        ],
        "lead": {
          "left": "status",
          "right": "project"
        },
        "active": {
          "status": "yes",
          "project": "hotkey_only",
          "status_sub": "no"
        },
        "freeRoam": {
          "status": "minimal",
          "project": "off"
