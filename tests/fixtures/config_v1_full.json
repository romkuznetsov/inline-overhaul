{
  "schemaVersion": 1,
  "features": {
    "navigation": {
      "enabled": true
    },
    "pkm": {
      "enabled": true
    },
    "visual": {
      "enabled": false
    },
    "transform": {
      "enabled": true
    }
  },
  "navigation": {
