        "enabled": {
          "status": true,
          "project": true,
          "status_sub": false
        },
        "types": {
          "status": "tag",
          "project": "wikilink"
        },
        "labels": {
          "status": "Status",
          "project": "Project"
        },
        "strictNames": {
          "status": "status",
          "project": "project"
        },
        "propertiesByField": {
          "status": "status"
        }
      },
      "defaultMode": "right",
      "leftMode": {
        "fields": [
          {
            "id": "status",
            "orderKey": "left",
            "prefix": "",
            "enabled": true,
            "kind": "tag",
            "values": [
              {
                "token": "#todo",
                "active": true,
                "prefixMode": "checkbox",
                "checkboxToken": "[ ]"
              },
              {
                "token": "#done",
                "active": true,
                "prefixMode": "checkbox",
                "checkboxToken": "[x]"
              }
            ]
          },
          {
            "id": "status_sub",
            "prefix": "#",
            "enabled": false,
            "dependsOn": "status",
            "disabledForParentValues": [],
            "placeholder": "sub",
            "values": [
              ""
            ]
          }
        ]
      },
      "rightMode": {
        "fields": [
          {
            "id": "project",
            "orderKey": "right",
            "enabled": true,
            "kind": "wikilink",
            "placeholder": "project",
            "values": [
              {
                "token": "[[Inbox]]"
              }
            ]
          }
        ]
      },
      "elements": {
        "fields": [],
        "byField": {}
      },
      "prefixRules": {
        "resolver": "priority-first",
        "priorityMode": "by-checkbox-list",
        "fieldsOrderMode": "auto",
        "tagSubtagPriority": "tag-over-subtag",
        "priorityTargets": [
          "status"
        ],
        "priorityCheckboxes": [
          "[ ]",
          "[x]"
        ],
        "checkboxByFieldValue": {
          "status": {
            "#todo": "[ ]",
            "#done": "[x]"
          }
        }
      },
      "typeCheckboxByValue": {
        "#todo": "[ ]",
        "#done": "[x]"
      },
      "projects": {
        "byField": {
          "project": {
            "root": "Projects"
          }
        }
      },
      "somethingFromTheFuture": {
        "keptSomewhere": 1
      }
    }
