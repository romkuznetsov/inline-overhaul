node_modules/

# Собранный плагин. В репозитории лежит исходник, в релизе — сборка (A13,
# фаза 6 пункт 3). Собирается одной командой — `npm run build`, — и её же
# зовут `npm test`, `npm run install:test` и выпуск релиза, так что «забыть
# собрать» нечем.
#
# Держать сборку под контролем версий было двумя способами промахнуться сразу:
# на review это замечание, а в работе — тихий источник вопроса «почему у меня
# другое»: закоммиченный бандл живёт своей жизнью и расходится с исходником
# ровно в тот момент, когда кто-то поправил исходник и не пересобрал.
dist/

data.json
DEV_LOG.md
WORK_TODO.md
AGENTS.md
BUILD_GUARDRAILS.md
log/
*.log
*.ndjson
*.tmp
*.bak

# тестовый vault лежит рядом с репозиторием, но на всякий случай
test-vault/

# Копии настоящего data.json заказчика для приёмки фазы 2 (PRD фаза 2,
# решение 2026-08-30). В них имена его папок, тегов и путей — в репозиторий
# они не попадают. Отчёт по такому файлу строится
# `node tools/migration_report.js <файл>`.
tests/fixtures/data_owner_*

# Карта чтений собирается инструментом и не хранится: замороженный текст через
# неделю разойдётся с кодом. Пересобрать — `node tools/read_map_v1.js . read_map.md`.
read_map.md
