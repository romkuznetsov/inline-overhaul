# transform — шаги записи (что показывается — transform.md)
# «Open note after creation» открывает новую вкладку; назад — щелчок по вкладке «Party plans».
# Его слово 2026-10-06: Transform — нажатием на плавающую кнопку → в конце строки, а не клавишей.
title Inline to note | Turn a line into its own note and link to it
preset transform.inline2note.openTarget = true
open Party plans.md
caret - [ ] #todo || [Garden party] invite the neighbors
# Каркас 2026-10-05: включение на камеру; Open note after creation выставлен заранее.
stage Inline to note
say Inline to note → on, and its Floating button →
settings Transform
set Inline to note = on
set Floating button = on
caret - [ ] #todo || [Garden party] invite the neighbors
say Click → : the line becomes a note, named from its [brackets]
click →
expect - [ ] #todo || invite the neighbors
say The line now links to the note
click Party plans
expect ## This week / - [ ] [[Garden party]] || #processed

stage Line above: Fixed text
say Line above the text → Fixed text
settings Transform
set Line above the text = Fixed text
caret - [ ] #todo || [Bake sale] order the cake
say The note starts with the fixed text, not the date
click →
expect ### Captured / - [ ] #todo || order the cake
click Party plans

stage Note name: Ask
say Note name → Ask
settings Transform
set Note name = Ask
caret - Find a recipe for a lemon cake with berries
say Ask → you type the name yourself
click →
type Lemon cake
click Create
pause 1000
expect ### Captured / - Find a recipe for a lemon cake with berries
