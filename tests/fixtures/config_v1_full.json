    "moveSelection": {
      "enabled": false,
      "inlineEnabled": false,
      "prefixCyclerEnabled": true,
      "indentFallbackEnabled": false,
      "onCycleEnd": "indent",
      "cycleOrder": [
        "#",
        "##",
        "- ",
        ""
      ],
      "inlineMoveMode": "word"
    },
    "jumpToHeader": {
      "enabled": false,
      "centerCursor": false,
      "centerDelayMs": 90,
      "centerThrottleMs": 250,
      "jumpMode": "edge",
      "edgeMode": "start-end",
      "jumpCursorPosition": "end"
    },
    "navigateInline": {
      "enabled": true,
      "stepMode": "word",
      "boundaryJump": true,
      "onBoundary": "wrap"
    }
  },
  "rules": {},
