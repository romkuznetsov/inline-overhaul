            "#done": {
              "fillColor": "",
              "textColor": "#b04f4f",
              "visibility": "empty",
              "customText": ""
            }
          }
        },
        "userTags": {
          "#idea": {
            "fillColor": "#4af28a",
            "textColor": "",
            "visibility": "custom",
            "customText": "i"
          }
        },
        "strip": {
          "active": true,
          "fieldId": "status",
          "tagVisibility": false,
          "hideSeparatorWhenOnlyStripToken": true,
