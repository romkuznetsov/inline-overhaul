  "visual": {
    "displayModes": {
      "leftovers": true
    },
    "colors": {
      "leftovers": true
    },
    "tags": {
      "opacityLeft": 33
    }
  },
  "transform": {
    "inline2fleet": {
      "leftovers": true
    },
    "inline2note": {
      "enabled": true,
      "templateFolder": "Templates/Inline",
      "outputFolder": "Notes",
      "defaultTemplate": "task.md",
      "smartRules": [
        {
          "id": "r1",
          "tags": [
            "#todo"
          ],
          "targetTemplate": "task.md"
        }
      ],
      "noteName": {
        "mode": "explicit",
        "explicitNameDelimiters": "()",
        "autoWordsCount": 6,
        "preferHeaderTitle": true
      },
      "nameCollision": {
        "mode": "append_number"
      },
      "placement": {
        "position": "end",
        "headerMode": "datetime",
        "customHeaderText": "### Inline transformed",
        "datetimeHeaderFormat": "YYYY-MM-DD HH:mm"
      },
      "sourceProcessing": {
        "cleanupFieldIds": [
          "status"
        ],
        "processedToken": "#processed",
        "processedTokenPanel": "left",
        "replacePayloadWithLink": false,
        "visual": {
          "enabled": true,
          "color": "#888888",
          "opacity": 0.65
        }
      },
      "flyingButton": {
        "enabled": true
      },
      "preview": {
        "sampleLine": "- [ ] #todo #context"
      },
      "yamlNoteFormat": "clean",
      "openTransformedNote": true,
      "sublinesBehavior": "move"
    }
